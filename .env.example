# GEMINI_API_KEY: Required for Gemini AI API calls on full-stack hosts (Express/Node.js).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GEMINI_API_KEY: Optional client-side API key for static hosting like Netlify or Vercel.
VITE_GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
